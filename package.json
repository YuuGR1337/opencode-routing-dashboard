{
  "name": "opencode-routing-dashboard",
  "version": "0.1.0",
  "description": "Real-time localhost dashboard for OpenCode routing",
  "license": "MIT",
  "type": "module",
  "bin": {
    "opencode-routing-dashboard": "src/cli.ts"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "start": "bun run build && bun src/cli.ts",
    "dev": "bun run build && bun --watch src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
