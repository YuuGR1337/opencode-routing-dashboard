[Unit]
Description=OpenCode routing dashboard

[Service]
Type=simple
# Set PATH to include bun and the installed dashboard executable if needed.
# Environment=PATH=%h/.bun/bin:/usr/local/bin:/usr/bin
# Environment=ORD_STATE_DIR=%h/.local/state/opencode
ExecStart=/usr/bin/env opencode-routing-dashboard serve
Restart=on-failure

[Install]
WantedBy=default.target
